# ============================================================
# 环境变量模板 —— 复制本文件为 .env，填入你自己的值。
# 本文件允许提交到 Git；真正的 .env 已被 .gitignore 排除，绝不提交。
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 你的 MySQL root 密码
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=olist_db
MYSQL_ALGO_DB=olist_algo_db

# ---------- LLM 底座（OpenAI 兼容协议，DeepSeek/通义/智谱/本地 Ollama 均可） ----------
# 不设 LLM_API_KEY 时，系统自动降级为 offline 规则引擎（可跑通管线，但不是真模型）
LLM_API_KEY=sk-your_deepseek_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=45
# ReAct 最多几轮工具调用（默认 4；调大更慢更全，调小更快）
LLM_MAX_STEPS=4
# 单轮最多几次工具调用（防跑飞，默认 6）
LLM_MAX_TOOL_CALLS=6
# RAG 一次召回几段（默认 4）
LLM_RAG_TOP_K=4
# RAG 相关性下限，低于该分数不注入（默认 0.05）
LLM_RAG_MIN_SCORE=0.05
# 消融模式：full | no_tools | no_rag | baseline
LLM_MODE=full

# ---------- 兼容别名（可留空） ----------
# 有些工具链习惯用 OPENAI_API_KEY / OPENAI_BASE_URL，填了会覆盖上面两项
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
