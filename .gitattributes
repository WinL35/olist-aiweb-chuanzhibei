# ============================================================================
# 统一换行符与文本/二进制判定
# ----------------------------------------------------------------------------
# 背景：仓库在 Windows 上开发，Git 默认 core.autocrlf=true 会让工作区变 CRLF。
# 这本身没问题，但缺一条显式规则时，不同机器 clone 下来容易出现
# 「只改了换行、diff 全红」的伪改动。这里把规则写进仓库，任何人 clone 都一致。
#
# 规则：仓库内一律 LF。工作区由各平台 checkout 时自行转换。
# ============================================================================

* text=auto eol=lf

# ---- 二进制：禁止任何换行转换与文本 diff ----
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.pptx  binary
*.zip   binary
*.db    binary
*.sqlite binary
*.woff  binary
*.woff2 binary

# ---- 平台相关脚本：保持各自平台的换行 ----
*.sh    text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# ---- 中文名脚本（启动后端.py 等）按 Python 源码处理 ----
*.py    text eol=lf
